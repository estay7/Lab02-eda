import java.util.LinkedList;
import java.util.Stack;
import java.time.LocalTime;
import java.util.Queue;
class Voto {
    private int ID;
    private int votanteID;
    private int candidatoID;
    private String timeStamp;

    public Voto(int ID, int votanteID, int candidatoID, int hora) {
        this.ID = ID;
        this.votanteID = votanteID;
        this.candidatoID = candidatoID;

        int horas = hora / 10000;
        int resto = hora % 10000;
        int minutos = resto / 100;
        int segundos = resto % 100;

        String horaStr = "";
        if (horas < 10) {
            horaStr += "0";
        }
        horaStr += horas;

        String minutoStr = "";
        if (minutos < 10) {
            minutoStr += "0";
        }
        minutoStr += minutos;

        String segundoStr = "";
        if (segundos < 10) {
            segundoStr += "0";
        }
        segundoStr += segundos;
        this.timeStamp = horaStr + ":" + minutoStr + ":" + segundoStr;
    }

    public int getId() {
        return ID;
    }

    public int getVotanteID() {
        return votanteID;
    }

    public int getCandidatoID() {
        return candidatoID;
    }

    public String getTimeStamp() {
        return timeStamp;
    }

    public void setId(int ID) {
        this.ID = ID;
    }

    public void setVotanteID(int votanteID) {
        this.votanteID = votanteID;
    }

    public void setCandidatoID(int candidatoID) {
        this.candidatoID = candidatoID;
    }
}

class Candidato {
    private int id;
    private String nombre;
    private String partido;
    private Queue<Voto> votosRecibidos;

    public Candidato(int id, String nombre, String partido) {
        this.id = id;
        this.nombre = nombre;
        this.partido = partido;
        this.votosRecibidos = new LinkedList<>();
    }

    public int getID() {
        return id;
    }

    public void setID(int id) {
        this.id = id;
    }

    public String getNombre() {
        return nombre;
    }

    public void setNombre(String nombre) {
        this.nombre = nombre;
    }

    public String getPartido() {
        return partido;
    }

    public void setPartido(String partido) {
        this.partido = partido;
    }

    public Queue<Voto> getVotosRecibidos() {
        return votosRecibidos;
    }

    public void setVotosRecibidos(Queue<Voto> votosRecibidos) {
        this.votosRecibidos = votosRecibidos;
    }

    public void agregarVoto(Voto v) {
        votosRecibidos.add(v);
    }
}

class Votante {
    private int id;
    private String nombre;
    private boolean voto;

    public Votante(int id, String nombre, boolean voto) {
        this.id = id;
        this.nombre = nombre;
        this.voto = voto;
    }

    public int getId() {
        return id;
    }

    public void setId(int id) {
        this.id = id;
    }

    public String getNombre() {
        return nombre;
    }

    public void setNombre(String nombre) {
        this.nombre = nombre;
    }

    public boolean isVoto() {
        return voto;
    }

    public void setVoto(boolean voto) {
        this.voto = voto;
    }

    public void marcarComoVotado() {
        this.voto = true;
    }
}

class UrnaElectoral {
    private LinkedList<Candidato> listaCandidatos;
    private Stack<Voto> historialVotos;
    private Queue<Voto> votosReportados;
    private int idCounter;

    public UrnaElectoral() {
        listaCandidatos = new LinkedList<>();
        historialVotos = new Stack<>();
        votosReportados = new LinkedList<>();
        idCounter = 0;
    }

    public boolean verificarVotante(Votante votante) {
        return votante.isVoto();
    }

    public boolean registrarVoto(Votante votante, int candidatoID) {
        if (verificarVotante(votante)) {
            System.out.println("El votante ya votó");
            return false;
        }
        Candidato candidato = null;
        for (Candidato c : listaCandidatos) {
            if (c.getID() == candidatoID) {
                candidato = c;
                break;
            }
        }
        if (candidato == null) {
            System.out.println("Candidato no encontrado");
            return false;
        }

        LocalTime now = LocalTime.now();
        int hora = now.getHour() * 10000 + now.getMinute() * 100 + now.getSecond();

        Voto newVoto = new Voto(idCounter++, votante.getId(), candidatoID, hora);
        candidato.agregarVoto(newVoto);
        historialVotos.push(newVoto);
        votante.marcarComoVotado();
        return true;
    }

    public boolean reportarVoto(Candidato candidato, int idVoto) {
        Queue<Voto> votosTemporales = new LinkedList<>();
        boolean encontrado = false;
        while (!candidato.getVotosRecibidos().isEmpty()) {
            Voto v = candidato.getVotosRecibidos().poll();
            if (v.getId() == idVoto && !encontrado) {
                votosReportados.add(v);
                encontrado = true;
            } else {
                votosTemporales.add(v);
            }
        }
        candidato.setVotosRecibidos(votosTemporales);
        if (!encontrado) {
            System.out.println("Voto no encontrado");
        }
        return encontrado;
    }

    public String obtenerResultados() {
        String resultados = "";

        for (Candidato c : listaCandidatos) {
            resultados += c.getNombre() + " (" + c.getPartido() + "): " + c.getVotosRecibidos().size() + " votos\n";
        }

        return resultados;
    }

    public void agregarCandidato(Candidato candidato) {
        listaCandidatos.add(candidato);
    }
}

public class Main {
    public static void main(String[] args) {
        UrnaElectoral urna = new UrnaElectoral();
        
        Candidato candidato1 = new Candidato(1, "Marcos Fantoval", "Partido A");
        Candidato candidato2 = new Candidato(2, "Cristián Llull", "Partido B");
      
        urna.agregarCandidato(candidato1);
        urna.agregarCandidato(candidato2);
        
        Votante votante1 = new Votante(101, "Martin Estay", false);
        Votante votante2 = new Votante(102, "Diego Peñailillo", false);
        Votante votante3 = new Votante(103, "Rommel Bustamante ", false);
        
      
        System.out.println("Registrando votos...");
        urna.registrarVoto(votante1, 1); 
        urna.registrarVoto(votante2, 2); 
        urna.registrarVoto(votante3, 1); 
        
        
        System.out.println("\nIntentando votar dos veces...");
        urna.registrarVoto(votante1, 2);
        
       
        System.out.println("\nResultados de la votación:");
        System.out.println(urna.obtenerResultados());
        
        
        System.out.println("Reportando un voto");
        urna.reportarVoto(candidato1, 0);
        
        
        System.out.println("\nResultados después de reportar un voto:");
        System.out.println(urna.obtenerResultados());
    }
}
